name: A33 USB 6-Variant Blind Test

on:
  workflow_dispatch:
  push:
    branches: [ main, master ]

jobs:
  build-matrix:
    runs-on: ubuntu-latest
    strategy:
      fail-fast: false
      matrix:
        variant:
          # 版本1：强改设备树为纯从机(Peripheral)，彻底忽略ID脚与VBUS检测，启动后同时开启Fastboot与屏幕日志
          - name: "01_dts_force_peripheral_fastboot"
            patch_dts: "yes"
            id_det: ""
            vbus_det: ""
            vbus_pin: ""
            usb_host: "no"
            cmd: "echo === USB0 PERIPHERAL FASTBOOT ===; fastboot 0"

          # 版本2：强改设备树为纯从机，开启USB虚拟串口(CDC ACM)，成功则电脑直接多出COM口
          - name: "02_dts_force_peripheral_usbacm"
            patch_dts: "yes"
            id_det: ""
            vbus_det: ""
            vbus_pin: ""
            usb_host: "no"
            cmd: "echo === STARTING USB ACM SERIAL ===; setenv stdout vidconsole,usbacm; setenv stderr vidconsole,usbacm; setenv stdin serial,usbacm"

          # 版本3：使用 AXP223 PMIC 检测 VBUS（多数10寸A33平板采用此方案）
          - name: "03_axp223_vbus_fastboot"
            patch_dts: "no"
            id_det: ""
            vbus_det: "axp_vbus"
            vbus_pin: ""
            usb_host: "no"
            cmd: "echo === AXP_VBUS FASTBOOT ===; fastboot 0"

          # 版本4：公板标准引脚组合 (ID=PH9, VBUS_DET=PH10)
          - name: "04_pin_ph9_ph10_fastboot"
            patch_dts: "no"
            id_det: "PH9"
            vbus_det: "PH10"
            vbus_pin: ""
            usb_host: "no"
            cmd: "echo === PH9_PH10 FASTBOOT ===; fastboot 0"

          # 版本5：开启 USB1 Host 主机模式（防止你的接口实际接在USB1而非USB0，插USB键盘或U盘可测）
          - name: "05_usb1_host_kbd_scan"
            patch_dts: "no"
            id_det: "PH8"
            vbus_det: ""
            vbus_pin: "PH11"
            usb_host: "yes"
            cmd: "echo === SCANNING USB HOST ===; usb start; usb tree; usb info"

          # 版本6：纯屏幕打印所有环境变量与设备状态（确认屏幕控制台输出是否正常）
          - name: "06_screen_console_diag"
            patch_dts: "yes"
            id_det: ""
            vbus_det: ""
            vbus_pin: ""
            usb_host: "yes"
            cmd: "echo === SCREEN CONSOLE OK ===; bdinfo; dm tree"

    steps:
      - name: 安装交叉编译环境
        run: |
          sudo apt-get update
          sudo apt-get install -y gcc-arm-linux-gnueabihf build-essential bison flex \
            libssl-dev device-tree-compiler python3-setuptools python3-dev swig

      - name: 拉取主线 U-Boot 源码
        run: git clone https://denx.de --depth=1

      - name: 应用配置并编译 [${{ matrix.variant.name }}]
        working-directory: ./u-boot
        run: |
          make ARCH=arm CROSS_COMPILE=arm-linux-gnueabihf- ga10h_v1_1_defconfig

          # 1. 强制将标准输出绑定到 10.1寸(1024x600) 屏幕，开机即在屏幕左上角显示白字日志
          ./scripts/config --enable CONFIG_VIDEO_SUNXI
          ./scripts/config --set-str CONFIG_VIDEO_LCD_MODE "x:1024,y:600,depth:18,pclk_khz:51200,le:160,ri:160,up:23,lo:12,hs:1,vs:1,sync:3,vmode:0"
          ./scripts/config --enable CONFIG_CONSOLE_MUX
          ./scripts/config --enable CONFIG_SYS_CONSOLE_IS_IN_ENV
          ./scripts/config --enable CONFIG_VIDCONSOLE_AS_LCD

          # 2. 开启 MUSB (USB0) 及 Fastboot / CDC-ACM 虚拟串口
          ./scripts/config --enable CONFIG_USB
          ./scripts/config --enable CONFIG_USB_MUSB_SUNXI
          ./scripts/config --enable CONFIG_USB_MUSB_GADGET
          ./scripts/config --enable CONFIG_USB_GADGET
          ./scripts/config --enable CONFIG_USB_GADGET_DOWNLOAD
          ./scripts/config --enable CONFIG_CMD_FASTBOOT
          ./scripts/config --enable CONFIG_USB_FUNCTION_FASTBOOT
          ./scripts/config --enable CONFIG_USB_FUNCTION_ACM
          ./scripts/config --enable CONFIG_USB_ETHER

          # 3. 若需要测试 USB1 Host（接键盘/U盘），开启 EHCI/OHCI 与 USB 键盘支持
          if [ "${{ matrix.variant.usb_host }}" = "yes" ]; then
            ./scripts/config --enable CONFIG_USB_EHCI_HCD
            ./scripts/config --enable CONFIG_USB_EHCI_SUNXI
            ./scripts/config --enable CONFIG_USB_OHCI_HCD
            ./scripts/config --enable CONFIG_USB_OHCI_SUNXI
            ./scripts/config --enable CONFIG_CMD_USB
            ./scripts/config --enable CONFIG_USB_KEYBOARD
          fi

          # 4. 强改设备树：绕过 ga10h_v1_1 底板差异，强制把 usb_otg 设为纯从机模式
          if [ "${{ matrix.variant.patch_dts }}" = "yes" ]; then
            sed -i 's/dr_mode = "otg";/dr_mode = "peripheral";/g' arch/arm/dts/sun8i-a33-ga10h-v1.1.dts
          fi

          # 5. 设置 USB 引脚与开机自启命令
          ./scripts/config --set-str CONFIG_USB0_ID_DET "${{ matrix.variant.id_det }}"
          ./scripts/config --set-str CONFIG_USB0_VBUS_DET "${{ matrix.variant.vbus_det }}"
          ./scripts/config --set-str CONFIG_USB0_VBUS_PIN "${{ matrix.variant.vbus_pin }}"
          ./scripts/config --enable CONFIG_USE_BOOTCOMMAND
          ./scripts/config --set-str CONFIG_BOOTCOMMAND "${{ matrix.variant.cmd }}"

          make ARCH=arm CROSS_COMPILE=arm-linux-gnueabihf- olddefconfig
          make ARCH=arm CROSS_COMPILE=arm-linux-gnueabihf- -j$(nproc)

      - name: 打包产物 [${{ matrix.variant.name }}]
        uses: actions/upload-artifact@v4
        with:
          name: ${{ matrix.variant.name }}
          path: u-boot/u-boot-sunxi-with-spl.bin
